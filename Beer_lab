      padding: 25px;
    }


    .panel h2 {

      text-align: left;

      margin-top: 0;

      margin-bottom: 20px;
    }


    /* =========================
       PARAMÈTRES
       ========================= */

    .settings-grid {

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;

      margin-bottom: 25px;
