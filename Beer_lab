       ===================================================== */

    function calculate() {

      const volume =
        Math.max(
          parseFloat(
            volumeInput.value
          ) || 20,
          1
        );


      const og =
        calculateOG(
          volume
        );


      const abv =
        calculateABV(
          og
        );


      const ibu =
        calculateIBU(
          og,
          volume
        );


      const ebc =
        calculateEBC(
          volume
        );


      document
        .getElementById(
          "ogValue"
        )
        .textContent =
        og.toFixed(3);


      document
        .getElementById(
          "abvValue"
        )
        .textContent =
        formatNumber(
          abv
        ) +
        " %";


      document
        .getElementById(
          "ibuValue"
        )
        .textContent =
        Math.round(
          ibu
        );


      document
        .getElementById(
          "ebcValue"
        )
        .textContent =
        Math.round(
          ebc
        );


      renderTargets(
        og,
        abv,
        ibu,
        ebc
      );

    }


    /* =====================================================
       CIBLES STYLE
       ===================================================== */

    function checkRange(
      value,
      range,
      decimals = 0
    ) {

      const text =
        range[0].toFixed(
          decimals
        ) +
        " – " +
        range[1].toFixed(
          decimals
        );


      if (
        value >= range[0] &&
        value <= range[1]
      ) {

        return `
          <span class="target-good">
            ✓ ${text}
          </span>
        `;

      }


      return `
        <span class="target-warning">
          ⚠ ${text}
        </span>
      `;

    }


    function renderTargets(
      og,
      abv,
      ibu,
      ebc
    ) {

      const style =
        STYLES[
          styleSelect.value
        ];


      document
        .getElementById(
          "targetBox"
        )
        .innerHTML = `

          <div class="target-title">

            🎯 Cible :
            ${escapeHTML(style.name)}

          </div>


          <div>

            OG :
            ${checkRange(
              og,
              style.og,
              3
            )}

          </div>


          <div>

            ABV :
            ${checkRange(
              abv,
              style.abv,
              1
            )}
            %

          </div>


          <div>

            IBU :
            ${checkRange(
              ibu,
              style.ibu,
              0
            )}

          </div>


          <div>

            EBC :
            ${checkRange(
              ebc,
              style.ebc,
              0
            )}

          </div>

      `;

    }


    /* =====================================================
       RECETTE ALEATOIRE
       ===================================================== */

    function randomRecipe() {

      selected = [];


      const styles =
        Object.keys(
          STYLES
        );


      const randomStyle =
        randomFrom(
          styles
        );


      styleSelect.value =
        randomStyle;


      /*
       * Malts
       */

      for (
        let i = 0;
        i < 3;
        i++
      ) {

        const item =
          randomFrom(
            DB.malt
          );


        selected.push({

          id:
            Date.now() +
            Math.random(),

          type: "malt",

          name: item[0],

          aroma: item[1],

          tag: item[2],

          data: item,

          amount:
            Math.round(
              (
                1 +
                Math.random() *
                2.5
              ) * 10
            ) / 10

        });

      }


      /*
       * Houblons
       */

      for (
        let i = 0;
        i < 3;
        i++
      ) {

        const item =
          randomFrom(
            DB.hop
          );


        selected.push({

          id:
            Date.now() +
            Math.random(),

          type: "hop",

          name: item[0],

          aroma: item[1],

          tag: item[2],

          data: item,

          amount:
            Math.round(
              (
                15 +
                Math.random() *
                45
              ) / 5
            ) * 5

        });

      }


      /*
       * Levure
       */

      const yeast =
        randomFrom(
          DB.yeast
        );


      selected.push({

        id:
          Date.now() +
          Math.random(),

        type: "yeast",

        name: yeast[0],

        aroma: yeast[1],

        tag: yeast[2],

        data: yeast,

        amount: 1

      });


      /*
       * Ajout
       */

      if (
        Math.random() <
        0.5
      ) {

        const adjunct =
          randomFrom(
            DB.adjunct
          );


        selected.push({

          id:
            Date.now() +
            Math.random(),

          type: "adjunct",

          name: adjunct[0],

          aroma: adjunct[1],

          tag: adjunct[2],

          data: adjunct,

          amount:
            Math.round(
              (
                100 +
                Math.random() *
                500
              ) / 10
            ) * 10

        });

      }


      volumeInput.value =
        20;


      renderSelected();

      calculate();

      generateName();

      animateBottle();

    }


    /* =====================================================
       COPIER RECETTE
       ===================================================== */

    async function copyRecipe() {

      const volume =
        parseFloat(
          volumeInput.value
        ) || 20;


      const og =
        calculateOG(
          volume
        );


      const abv =
        calculateABV(
          og
        );


      const ibu =
        calculateIBU(
          og,
          volume
        );


      const ebc =
        calculateEBC(
          volume
        );


      const ingredients =
        selected
          .map(
            item => {

              const unit =
                item.type === "malt"
                  ? "kg"
                  : item.type === "hop"
                    ? "g"
                    : item.type === "yeast"
                      ? "sachet"
                      : "g";


              return (
                "- " +
                item.name +
                " : " +
                item.amount +
                " " +
                unit
              );

            }
          )
          .join("\n");


      const text =

`🍺 ${generatedName}

VERIHOP BEER LAB

Style : ${STYLES[styleSelect.value].name}
Volume : ${volume} L

OG : ${og.toFixed(3)}
ABV : ${abv.toFixed(1)} %
IBU : ${Math.round(ibu)}
Couleur : ${Math.round(ebc)} EBC

Ingrédients :

${ingredients || "- Aucun"}

Créé avec le VERIHOP Beer Lab`;


      try {

        await navigator
          .clipboard
          .writeText(
            text
          );


        const button =
          document.getElementById(
            "shareBtn"
          );


        const oldText =
          button.textContent;


        button.textContent =
          "✅ Recette copiée !";


        setTimeout(
          () => {

            button.textContent =
              oldText;

          },
          1800
        );

      }

      catch(error) {

        alert(
          text
        );

      }

    }


    /* =====================================================
       ONGLETS
       ===================================================== */

    document
      .querySelectorAll(
        ".tab-button"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              document
                .querySelectorAll(
                  ".tab-button"
                )
                .forEach(
                  b =>
                    b.classList.remove(
                      "active"
                    )
                );


              button.classList.add(
                "active"
              );


              currentType =
                button.dataset.type;


              currentAroma =
                "all";


              searchInput.value =
                "";


              renderAromaFilters();

              renderIngredients();

            }
          );

        }
      );


    /* =====================================================
       EVENEMENTS
       ===================================================== */

    searchInput.addEventListener(
      "input",
      renderIngredients
    );


    volumeInput.addEventListener(
      "input",
      calculate
    );


    styleSelect.addEventListener(
      "change",
      () => {

        calculate();

        generateName();

      }
    );


    document
      .getElementById(
        "randomBtn"
      )
      .addEventListener(
        "click",
        randomRecipe
      );


    document
      .getElementById(
        "clearBtn"
      )
      .addEventListener(
        "click",
        () => {

          selected = [];

          generatedName =
            "Ta création";


          recipeName.textContent =
            generatedName;


          bottleLabel.innerHTML =
            "VERIHOP<br>BEER LAB";


          renderSelected();

          calculate();

        }
      );


    document
      .getElementById(
        "nameBtn"
      )
      .addEventListener(
        "click",
        () => {

          generateName();

          animateBottle();

        }
      );


    document
      .getElementById(
        "shareBtn"
      )
      .addEventListener(
        "click",
        copyRecipe
      );


    /* =====================================================
       INITIALISATION
       ===================================================== */

    renderAromaFilters();

    renderIngredients();

    renderSelected();

    calculate();

  </script>


</body>

</html>
