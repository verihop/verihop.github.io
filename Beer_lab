    function renderIngredients() {

      const query =
        searchInput.value
          .trim()
          .toLowerCase();


      const filtered =
        DB[currentType]
          .filter(
            item => {

              const matchesSearch =
                !query ||

                item[0]
                  .toLowerCase()
                  .includes(query) ||

                item[1]
                  .toLowerCase()
                  .includes(query) ||

                item[2]
                  .toLowerCase()
                  .includes(query);


              const matchesAroma =
                currentAroma === "all" ||
                item[2] === currentAroma;


              return (
                matchesSearch &&
                matchesAroma
              );

            }
          );


      ingredientList.innerHTML =
        "";


      if (!filtered.length) {

        ingredientList.innerHTML = `

          <div class="empty-list">
