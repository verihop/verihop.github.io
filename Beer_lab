       ===================================================== */

    function escapeHTML(value) {

      return String(value)

        .replace(/&/g,"&amp;")

        .replace(/</g,"&lt;")

        .replace(/>/g,"&gt;")

        .replace(/"/g,"&quot;")

        .replace(/'/g,"&#039;");

    }


    function formatNumber(
      value,
      decimals = 1
    ) {

      return Number(value)

        .toFixed(decimals)

        .replace(".",",");

    }


    function getTypeLabel(type) {

      const labels = {

        malt: "Malt",

        hop: "Houblon",

        yeast: "Levure",

        adjunct: "Ajout"

      };

      return labels[type] || type;

    }


