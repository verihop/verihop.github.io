    /* =====================================================
       CALCUL OG
       ===================================================== */

    function calculateOG(
      volume
    ) {

      const efficiency =
        0.75;


      let points = 0;


      selected

        .filter(
          item =>
            item.type === "malt"
        )

        .forEach(
          item => {

            const ppg =
              item.data[3];


            const pounds =
              item.amount *
              2.20462;


            points +=
              pounds *
              ppg *
              efficiency /
              (
                volume *
                0.264172
              );

          }
        );


      /*
       * Fruits / sucres
       */

      selected

        .filter(
          item =>
            item.type === "adjunct"
        )

        .forEach(
          item => {

            const name =
              item.name
                .toLowerCase();


            if (
              name.includes("sirop") ||
              name.includes("miel")
            ) {

              points +=
                item.amount *
                0.9 /
                volume;

            }

            else if (
              !name.includes("lactose")
            ) {

              points +=
                item.amount *
                0.15 /
                volume;

            }

          }
        );


      return 1 +
        points /
        1000;

    }


    /* =====================================================
       CALCUL ABV
       ===================================================== */

    function calculateABV(
      og
    ) {

      const yeast =
        selected.find(
          item =>
            item.type === "yeast"
        );


      const attenuation =
        yeast
          ? yeast.data[3]
          : 0.75;


      const fg =
        1 +
        (
          og - 1
        ) *
        (
          1 -
          attenuation
        );


      return (
        og -
        fg
      ) *
      131.25;

    }


    /* =====================================================
       CALCUL IBU
       ===================================================== */

    function calculateIBU(
      og,
      volume
    ) {

      let ibu = 0;


      const gravityFactor =
        1.65 *
        Math.pow(
          0.000125,
          Math.max(
            og - 1,
            0
          )
        );


      selected

        .filter(
          item =>
            item.type === "hop"
        )

        .forEach(
          item => {

            const alpha =
              item.data[3] /
              100;


            const grams =
              item.amount;


            /*
             * Tinseth simplifié
             * 60 minutes
             */

            const utilization =
              (
                1 -
                Math.exp(
                  -0.04 * 60
                )
              ) /
              4.15;


            ibu +=
              gravityFactor *
              utilization *
              alpha *
              grams *
              1000 /
              volume;

          }
        );


      return ibu;

    }


    /* =====================================================
       CALCUL EBC
       ===================================================== */

    function calculateEBC(
      volume
    ) {

      let mcu = 0;


      selected

        .filter(
          item =>
            item.type === "malt"
        )

        .forEach(
          item => {

            const pounds =
              item.amount *
              2.20462;


            const gallons =
              volume *
              0.264172;


            const lovibond =
              item.data[4] /
              1.97;


            mcu +=
              pounds *
              lovibond /
              Math.max(
                gallons,
                0.1
              );

          }
        );


      const srm =
        1.4922 *
        Math.pow(
          Math.max(
            mcu,
            0.01
          ),
          0.6859
        );


      return srm * 1.97;

    }


