    }


    /* =========================
       SECTIONS
       ========================= */

    section {

      max-width: 1150px;

      margin: 0 auto;

      padding: 45px 20px;
    }


    h1,
    h2 {

      text-align: center;

      color: #0b4d2a;
    }


    h1 {

      font-size:
        clamp(
