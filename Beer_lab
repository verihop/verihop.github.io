       HERO
       ========================= */

    .lab-hero {

      padding-top: 55px;

      padding-bottom: 35px;
    }


    .lab-badge {

      display: inline-block;

      background: #c7962a;

      color: white;

      font-weight: bold;

      padding: 6px 14px;

      border-radius: 30px;

