      font-size: 1.8rem;

      color: #2E6F40;

      font-weight: bold;

      margin:
        5px 0 18px;
    }


    /* =========================
       BOUTEILLE
       ========================= */

    .bottle-area {

      display: flex;

      justify-content: center;

      align-items: end;

      height: 210px;

      margin-bottom: 20px;

      position: relative;
    }


    .bottle {

      width: 75px;

      height: 165px;

      background:
        linear-gradient(
          90deg,
          #3b2415,
          #71431f,
          #3b2415
        );

      border-radius:
        13px 13px 10px 10px;

      position: relative;

      box-shadow:
        inset -7px 0 8px
        rgba(0,0,0,0.22),
        5px 8px 15px
        rgba(0,0,0,0.18);

      transition: 0.5s;
    }


    .bottle::before {

      content: "";

      position: absolute;

      top: -28px;

      left: 21px;

      width: 33px;

      height: 35px;

      background: #3b2415;

      border-radius:
        5px 5px 2px 2px;
    }


    .bottle::after {

      content: "";

      position: absolute;

      top: 48px;

      left: 7px;

      width: 61px;

      height: 55px;

      background: #f7f4ec;

      border-radius: 5px;
    }


    .bottle-label {

      position: absolute;

      z-index: 2;

      top: 58px;

      left: 13px;

      width: 49px;

      text-align: center;

      color: #2E6F40;

      font-size: 0.55rem;

      font-weight: bold;

      line-height: 1.1;
    }


    .bottle.bounce {

      animation:
        bottleBounce 0.7s ease;
    }


    @keyframes bottleBounce {

      0% {
        transform: rotate(0);
      }

      25% {
        transform: rotate(-7deg);
      }

      50% {
        transform: rotate(7deg);
      }

      75% {
        transform: rotate(-4deg);
      }

      100% {
        transform: rotate(0);
      }

    }


    /* =========================
       METRIQUES
       ========================= */

    .metrics {

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 10px;
    }


    .metric {

      background: #f7f4ec;

      border:
        1px solid
        #DCE8D8;

      border-radius: 12px;

      padding: 13px;

      text-align: center;
    }


    .metric-value {

      display: block;

      color: #2E6F40;

      font-size: 1.35rem;

      font-weight: bold;
    }


    .metric-label {

      color: #777;

      font-size: 0.78rem;
    }


    /* =========================
       CIBLES
       ========================= */

    .target-box {

      margin-top: 15px;

      padding: 12px;

      background: #eef4eb;

      border-radius: 10px;

      font-size: 0.85rem;
    }


    .target-title {

      font-weight: bold;

      color: #2E6F40;

      margin-bottom: 4px;
    }


    .target-good {

      color: #23713a;

      font-weight: bold;
    }


    .target-warning {

      color: #a66a00;

      font-weight: bold;
    }


    /* =========================
       RESUME
       ========================= */

    .recipe-summary {

      margin-top: 20px;

      border-top:
        1px solid
        #DCE8D8;

      padding-top: 15px;
    }


    /* =========================
       NOTICE
       ========================= */

    .notice {

      margin-top: 15px;

      color: #777;

      font-size: 0.75rem;

      text-align: center;
    }


    /* =========================
       FOOTER
       ========================= */

    footer {

      background: #0b4d2a;

      color: white;

      text-align: center;

      padding: 25px 15px;

      margin-top: 30px;
    }


    footer a {

      color: #c7962a;

      text-decoration: none;

      font-weight: bold;
    }


    /* =========================
       MOBILE
       ========================= */

    @media (max-width: 850px) {

      .lab-grid {

        grid-template-columns: 1fr;
      }


      .result-card {

        position: static;
      }

    }


    @media (max-width: 600px) {

      nav a {

        font-size: 0.9rem;

        padding: 7px 9px;
      }


      section {

        padding:
          35px 15px;
      }


      .panel {

        padding: 18px;
      }


      .settings-grid {

        grid-template-columns: 1fr;
      }


      .ingredient-list {

        grid-template-columns: 1fr;
      }


      .selected-item {

        grid-template-columns:
          minmax(0, 1fr)
          75px
          32px;
      }


      .button-row .btn {

        width: 100%;
      }

    }

  </style>

</head>


