    }


    /* =========================
       LAYOUT
       ========================= */

    .lab-grid {

      display: grid;

      grid-template-columns:
        minmax(0, 1.35fr)
        minmax(300px, 0.65fr);

      gap: 25px;

      align-items: start;
    }


    .panel {

      background: white;

      border:
