      flex-wrap: wrap;

      gap: 10px;

      margin-top: 20px;
    }


    .btn {

      border: 0;

      border-radius: 10px;

      padding: 11px 16px;

      cursor: pointer;

      font-weight: bold;

      font-size: 0.95rem;

      transition:
